# Copy to .env and fill in before docker compose up.
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-longer-random
# ── License signing (server-only secret) ──────────────────────────────
# Ed25519 private seed (base64 std, 32 bytes) for license signing.
# NEVER commit the real value, NEVER put it in the app or tests.
# After the 2026-09-06 rotation the current seed is recorded in
# server/LICENSE_ROTATION.md (SECRET — copy to the VPS .env, then shred
# that file) and in the local gitignored server/.env.
LICENSE_PRIVATE_KEY=change-me-base64-32-byte-seed
# ── Manual issuance allowlist (deny by default) ───────────────────────
# Comma-separated emails allowed to call POST /licenses/issue.
# Empty/missing = NOBODY may issue (fail closed).
LICENSE_ISSUER_ALLOWLIST=owner@apexbooks.in
# ── Razorpay ──────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys (for verifying payments server-side /
# creating payment links via API in future; the current checkout is a
# manually-created Payment Link, so these are optional today but required
# the moment the server calls Razorpay APIs).
RAZORPAY_KEY_ID=rzp_live_change-me
RAZORPAY_KEY_SECRET=change-me
# Dashboard → Settings → Webhooks → secret for the
# POST https://api.apexbooks.in/licenses/razorpay-webhook endpoint.
# Must EXACTLY match the dashboard value or every webhook 401s.
RAZORPAY_WEBHOOK_SECRET=change-me-razorpay-secret
